# 宿主机上的持久化数据目录；服务器部署时可填写绝对路径。
# 容器内始终映射为 /data，不要修改容器内路径。
HKC_STORAGE_PATH=./storage

# 平台运行镜像标签。
HKC_IMAGE=hkc-data-platform:v3.1

# MySQL 专用持久化目录，与平台 storage/ 并列；真实密码只写入部署机 .env。
# 首次启动前必须为下面两个密码变量设置非空且不同的值。
HKC_MYSQL_DATA_PATH=./mysql-data
HKC_MYSQL_DATABASE=hkc_platform
HKC_MYSQL_USER=hkc_app
HKC_MYSQL_PASSWORD=
HKC_MYSQL_ROOT_PASSWORD=

# 构建非 root 容器用户时使用的 UID/GID，可用 id -u 和 id -g 查看。
APP_UID=1000
APP_GID=1000

# 构建镜像时使用的 Python 软件包来源；默认保留官方 PyPI。
PIP_INDEX_URL=https://pypi.org/simple
PIP_DEFAULT_TIMEOUT=120

# 可选：可信局域网绑定地址。局域网覆盖需要实际 IPv4；服务器覆盖默认 0.0.0.0。
# HKC_LAN_BIND_ADDRESS=192.168.123.45

# 可选：兼容 OpenAI 接口的 VLM 服务；真实地址和令牌只写入 .env。
VLM_BASE_URL=
VLM_API_TOKEN=
QC_DOCTOR_TIMEOUT_SECONDS=1800

# 仅在叠加 deploy/compose.training-agent.yaml 时设置。必须位于支持 Unix socket
# 的 Linux 文件系统，不要指向 NTFS/exFAT 数据盘。
# HKC_TRAINING_AGENT_SOCKET_DIR=/home/example/.local/share/hkc-training-agent

# ZIP 安全限制：上传最大 10 GiB、解压后最大 50 GiB、最多 200000 个文件。
HKC_MAX_UPLOAD_BYTES=10737418240
HKC_MAX_EXPANDED_BYTES=53687091200
HKC_MAX_ARCHIVE_FILES=200000
