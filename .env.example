# Host path persisted outside the container. Use an absolute path on a server if desired.
# The container path remains /data and must not be changed.
HKC_STORAGE_PATH=./storage

# Build the non-root container user with the deployment account's numeric IDs.
# Check them with: id -u && id -g
APP_UID=1000
APP_GID=1000

# Image-build package source. Keep official PyPI by default; override locally only when needed.
PIP_INDEX_URL=https://pypi.org/simple
PIP_DEFAULT_TIMEOUT=120

# Optional trusted-LAN binding. Copy the current device's IPv4 and uncomment locally.
# HKC_LAN_BIND_ADDRESS=192.168.123.45

# Optional OpenAI-compatible VLM service. Configure real values in .env only.
VLM_BASE_URL=
VLM_API_TOKEN=
QC_DOCTOR_TIMEOUT_SECONDS=1800

# ZIP safety limits: 10 GiB upload, 50 GiB expanded content, 200000 archive entries.
HKC_MAX_UPLOAD_BYTES=10737418240
HKC_MAX_EXPANDED_BYTES=53687091200
HKC_MAX_ARCHIVE_FILES=200000
