# Python bytecode and caches
__pycache__/
*.py[cod]

# Local IDE configuration
.idea/
.marscode/
.vscode/

# Local desktop/tool temporary state
/tmp/

# Local virtual environments
.venv/
venv/

# Local environment variables (keep example files)
.env
.env.*
!.env.example

# Test, lint, and coverage outputs
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Runtime logs
*.log

# Platform storage. Keep only the documented directory skeleton in Git.
/storage/**
!/storage/**/
!/storage/README.md
!/storage/**/.gitkeep

# Legacy local dataset directory used by the previous prototype
/datas/

# Operating system metadata
Thumbs.db
Desktop.ini
.DS_Store

#tips
tips.txt
